# Copyright 2026 Jump Trading LLC
#
# An 'operator for' in a header -- in the preamble, where clangd skips function
# bodies -- keeps its body: each loop using it is made from it.
#
# RUN: rm -rf %t && split-file %s %t
# RUN: echo '-std=c++26' > %t/compile_flags.txt
# RUN: echo '-foperator-for' >> %t/compile_flags.txt
# RUN: clangd -enable-config=0 -check=%t/main.cpp 2>&1 | FileCheck %s

# CHECK: Built preamble
# CHECK-NOT: operator_for_no_body
# CHECK: All checks completed

#--- evens.h
struct Evens {
  int n;
  operator for() {
    for (int i = 0; i < n; i += 2)
      co_yield i;
  }
};

#--- main.cpp
#include "evens.h"
int sum() {
  int s = 0;
  for (int i : Evens{10})
    s += i;
  return s;
}
