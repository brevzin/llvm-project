//
// Lightweight forward header for consumer TUs using independently compiled
// consteval plugins (-fconsteval-plugin-load=). Pulls in zero STL headers.

#ifndef _LIBCPP_META_FWD
#define _LIBCPP_META_FWD

#if !defined(_LIBCPP_META) && __has_feature(reflection)

#include <__config>

_LIBCPP_BEGIN_NAMESPACE_STD
namespace meta {
inline namespace reflection_v2 {

using info = decltype(^^int);

// A stand-in for <meta>'s class of the same name: enough to declare, call and
// return from functions that take or give token sequences. (<meta> cannot be
// included after it.)
#  define _LIBCPP_META_FWD_DEFINES_TOKEN_SEQUENCE
class token_sequence {
public:
  constexpr token_sequence() noexcept = default;
};

} // namespace reflection_v2
} // namespace meta
_LIBCPP_END_NAMESPACE_STD

#endif // !defined(_LIBCPP_META) && __has_feature(reflection)

#endif // _LIBCPP_META_FWD
